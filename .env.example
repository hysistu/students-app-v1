API_ORIGIN=http://localhost:4000

# Gmail account that sends the public contact form.
GMAIL_USER=
# Google app password (16 letters). Spaces are fine; they are removed before send.
GMAIL_APP_PASSWORD=
# Inbox that receives messages. Leave empty to deliver to GMAIL_USER.
CONTACT_TO=

# OpenAI (TechLab Assistant on /ai). Keep this server-only — do not use NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

